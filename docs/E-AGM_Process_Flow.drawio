<mxfile host="app.diagrams.net">
  <diagram id="eagm-process-flow-v2" name="E-AGM Process Flow v2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ TITLE ═══ -->
        <mxCell id="title" value="E-AGM Process Flow — ระบบใหม่ | OMD Maintain Data เอง | ผู้ถือหุ้น Self-Register | Online &amp; Onsite" style="text;html=1;align=center;fontStyle=1;fontSize=15;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1180" height="36" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- SECTION 1: PRE-MEETING PHASE (ระบบใหม่)            -->
        <!-- ════════════════════════════════════════════════════ -->
        <mxCell id="hPre" value="🗓️  PRE-MEETING PHASE — ก่อนวันประชุม  |  OMD Admin จัดการข้อมูลได้เองผ่านระบบ (ไม่ต้องส่ง Excel ให้ ITD อีกต่อไป)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="65" width="1180" height="38" as="geometry" />
        </mxCell>

        <mxCell id="pm1" value="STEP 1: OMD Admin — ตั้งค่า Master&#xa;Login เข้าระบบ → ตั้งค่า: วันที่ประชุม, สถานที่, จำนวน Quorum&#xa;ปรับแก้ได้เองโดยตรงผ่านหน้า Admin Panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="680" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pm2" value="STEP 2: OMD Admin — นำเข้าและจัดการข้อมูลผู้ถือหุ้น&#xa;Import ไฟล์ Excel หรือกรอกข้อมูลตรง: holder | novote | termpartner&#xa;เพิ่ม / แก้ไข / ลบ ข้อมูลได้เองทั้งหมด ไม่ต้องผ่าน ITD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="205" width="680" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pm3" value="STEP 3: OMD Admin — จัดการวาระการประชุม&#xa;เพิ่ม / แก้ไข / เรียงลำดับ วาระ (termpartner)&#xa;กำหนด: ชื่อวาระ, ประเภท, จำนวนหุ้นเต็ม (full_term)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="680" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pm4" value="STEP 4: ITD — Backup DB ปีที่แล้ว + ทดสอบระบบ (Internal Test)&#xa;Backup SQL → ทดสอบ: ลงทะเบียน (Self-Register + Staff) + โหวต Online/Onsite ครบทุก scenario&#xa;ผ่านทุก case → Clear test data → ส่ง UAT ให้ OMD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="375" width="680" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pm5" value="STEP 5: UAT ร่วม OMD + ITD&#xa;OMD ทดสอบ: Self-Register + โหวต Online + เปลี่ยน Online→Onsite + Print Vote Card&#xa;✅ ผ่าน → Clear Test Data → เปิดระบบรับลงทะเบียนจริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="680" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pm6" value="✅ เปิดรับลงทะเบียนล่วงหน้า (Pre-Registration Window)&#xa;ผู้ถือหุ้นที่รับมอบฉันทะ / Staff / OMD Admin ช่วยลงทะเบียนแทนล่วงหน้าได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="545" width="680" height="55" as="geometry" />
        </mxCell>

        <!-- Pre-meeting edges -->
        <mxCell id="epm1pm2" edge="1" source="pm1" target="pm2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="epm2pm3" edge="1" source="pm2" target="pm3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="epm3pm4" edge="1" source="pm3" target="pm4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="epm4pm5" edge="1" source="pm4" target="pm5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="epm5pm6" edge="1" source="pm5" target="pm6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- DIVIDER: MEETING DAY                                 -->
        <!-- ════════════════════════════════════════════════════ -->
        <mxCell id="divDay" value="📅  วันประชุม — Meeting Day  |  ผู้ถือหุ้นมาได้ทั้ง Online และ Onsite  |  ทุก Role ทำงานพร้อมกัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="625" width="1180" height="38" as="geometry" />
        </mxCell>
        <mxCell id="epm6div" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="pm6" target="divDay" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ COLUMN HEADERS ═══ -->
        <mxCell id="hSH" value="👤  ผู้ถือหุ้น — Self-Register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="678" width="330" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hAdminOMD" value="⚙️  Admin OMD — จัดการวันประชุม + เปลี่ยน Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="365" y="678" width="480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hStaff" value="👥  Staff — Onsite Support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="678" width="370" height="35" as="geometry" />
        </mxCell>

        <mxCell id="edivSH" edge="1" source="divDay" target="hSH" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edivAdmin" edge="1" source="divDay" target="hAdminOMD" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edivStaff" edge="1" source="divDay" target="hStaff" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════ -->
        <!-- COLUMN 1: ผู้ถือหุ้น (Self-Register) -->
        <!-- ═══════════════════════════════════ -->
        <mxCell id="sh1" value="เข้า URL ระบบ (Self-Register)&#xa;ผ่าน Mobile / Browser / คอมพิวเตอร์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="730" width="310" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sh2" value="กรอกข้อมูลลงทะเบียน&#xa;รหัสผู้ถือหุ้น + เลขบัตรประชาชน&#xa;เบอร์โทร + Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="805" width="310" height="65" as="geometry" />
        </mxCell>

        <mxCell id="shErrData" value="❌ ข้อมูลไม่ตรง / novote&#xa;แจ้งเตือน → กรอกใหม่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="-180" y="820" width="195" height="40" as="geometry" />
        </mxCell>

        <mxCell id="sh3" value="รับ OTP: SMS / Email (10 นาที)&#xa;กรอก OTP 6 หลัก เพื่อยืนยันตัวตน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="895" width="310" height="55" as="geometry" />
        </mxCell>

        <mxCell id="shErrOtp" value="❌ OTP ผิด/หมดอายุ&#xa;ขอ OTP ใหม่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="-180" y="905" width="195" height="40" as="geometry" />
        </mxCell>

        <!-- Choice Diamond -->
        <mxCell id="shChoice" value="เลือกรูปแบบ&#xa;เข้าร่วมประชุม" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="978" width="250" height="80" as="geometry" />
        </mxCell>

        <!-- Online path -->
        <mxCell id="shOnlineBox" value="📱 ห้องรอประชุม (Online)&#xa;แสดง: ชื่อ, จำนวนหุ้น, Quorum %&#xa;status = online_registered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1095" width="145" height="75" as="geometry" />
        </mxCell>

        <!-- Onsite path -->
        <mxCell id="shOnsiteBox" value="🏢 Onsite&#xa;แจ้งเจ้าหน้าที่ที่ Venue&#xa;รับบัตร Vote Card&#xa;จาก Admin OMD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="1095" width="155" height="75" as="geometry" />
        </mxCell>

        <!-- Online Vote -->
        <mxCell id="shVote" value="🗳️ โหวต Online&#xa;เห็นด้วย / ไม่เห็นด้วย&#xa;งดออกเสียง / บัตรเสีย&#xa;บันทึก votes_online&#xa;(ไม่โหวต = auto-agree)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1210" width="145" height="95" as="geometry" />
        </mxCell>

        <!-- Shareholder edges -->
        <mxCell id="esh1sh2" edge="1" source="sh1" target="sh2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esh2Err" value="ไม่ตรง" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#b85450;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="sh2" target="shErrData" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eErrSh2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" source="shErrData" target="sh2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esh2sh3" value="✅ ตรง" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#82b366;fontSize=10;" edge="1" source="sh2" target="sh3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esh3Otp" value="OTP ผิด" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#b85450;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="sh3" target="shErrOtp" parent="1">
          <mxGeometry relative="1" as="geometry" />
