        </mxCell>
        <mxCell id="eaRptCmtg" edge="1" source="aRpt" target="aCmtg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════ -->
        <!-- COLUMN 3: Staff             -->
        <!-- ════════════════════════════ -->
        <mxCell id="st1" value="🔑 Login — Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
