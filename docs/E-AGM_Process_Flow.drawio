        <mxCell id="eErrOtpSh3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" source="shErrOtp" target="sh3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
