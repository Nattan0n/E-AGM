        <mxCell id="divSP" value="🔄  กรณีพิเศษ — ผู้ถือหุ้นลงทะเบียน Online แต่ต้องการเปลี่ยนเป็น Onsite วันจริง (Admin OMD ดำเนินการ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="1470" width="1180" height="38" as="geometry" />
