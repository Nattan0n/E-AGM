        </mxCell>
        <mxCell id="est4st5" value="Admin เปิดวาระ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" edge="1" source="st4" target="st5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ CROSS-COLUMN EDGES ═══ -->

        <!-- Admin Open → Online: โหวตได้ -->
        <mxCell id="eOpenOnline" value="เปิดวาระ → Online โหวตได้" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="aOpen" target="shOnlineBox" parent="1">
          <mxGeometry relative="1" as="geometry">
