        <!-- Registration types -->
        <mxCell id="st3a" value="👤 บุคคล&#xa;ลงทะเบียนตัวเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="878" width="105" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st3b" value="📄 มอบฉันทะ&#xa;ระบุผู้รับ + หุ้น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="878" width="105" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st3c" value="👥 กลุ่ม&#xa;สร้าง + สมาชิก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="878" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st4" value="💾 บันทึก regismaim + regissub&#xa;pre-fill ทุกวาระ = เห็นด้วย (default ก่อนเปิดวาระ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="960" width="350" height="55" as="geometry" />
        </mxCell>

        <!-- Vote on behalf -->
        <mxCell id="st5" value="🗳️ โหวตแทน Onsite&#xa;ค้นหาผู้ถือหุ้นที่ลงทะเบียนแล้ว&#xa;เลือก: เห็นด้วย / ไม่เห็น / งด / บัตรเสีย&#xa;UPDATE regissub (วาระละ 1 ครั้ง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="1175" width="350" height="80" as="geometry" />
        </mxCell>

        <!-- Late registration -->
        <mxCell id="stLate" value="⏰ ผู้มาสาย&#xa;ลงทะเบียนปกติ + บันทึก holderlate&#xa;(timestamp มาถึง)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
