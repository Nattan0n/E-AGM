        <mxCell id="st2" value="🔍 ค้นหาผู้ถือหุ้น&#xa;รหัส / ชื่อ / เลขบัตรประชาชน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="795" width="350" height="55" as="geometry" />
