        </mxCell>
        <mxCell id="eChoiceOnline" value="Online" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#82b366;fontStyle=1;fontSize=10;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="shChoice" target="shOnlineBox" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eChoiceOnsite" value="Onsite" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=#d6b656;fontStyle=1;fontSize=10;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" source="shChoice" target="shOnsiteBox" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOnlineVote" value="Admin เปิดวาระ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" edge="1" source="shOnlineBox" target="shVote" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════ -->
        <!-- COLUMN 2: Admin OMD         -->
        <!-- ════════════════════════════ -->
        <mxCell id="a1" value="🔑 Login — Admin OMD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="730" width="460" height="45" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="📊 Dashboard Realtime&#xa;จำนวนลงทะเบียน | Quorum % | Online vs Onsite | สถานะแต่ละวาระ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="795" width="460" height="55" as="geometry" />
        </mxCell>

        <!-- Change Status: Online → Onsite -->
        <mxCell id="aChgStatus" value="🔄 เปลี่ยน Status: Online → Onsite&#xa;กรณี: ผู้ถือหุ้นลงทะเบียน Online แต่ต้องการโหวตแบบ Onsite&#xa;ค้นหา Account → กด 'เปลี่ยนเป็น Onsite'&#xa;→ ยกเลิก online session → สร้าง regismaim + regissub&#xa;→ บันทึก audit_log (ใคร เวลาไหน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="870" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Print Vote Card -->
        <mxCell id="aPrint" value="🖨️ Print บัตร Vote&#xa;พิมพ์บัตรลงคะแนนสำหรับผู้ถือหุ้น Onsite&#xa;มี: ชื่อ, รหัส, จำนวนหุ้น, วาระทั้งหมด&#xa;แจกให้ผู้ถือหุ้น ณ Venue วันจริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="990" width="460" height="80" as="geometry" />
        </mxCell>

        <!-- Open Agenda -->
        <mxCell id="aOpen" value="▶️ เปิดวาระ (open = 1)&#xa;→ ผู้ถือหุ้น Online: เห็นปุ่มโหวต&#xa;→ Staff: โหวตแทน Onsite ได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="1090" width="460" height="65" as="geometry" />
        </mxCell>

        <!-- Close Agenda -->
        <mxCell id="aClose" value="⏹️ ปิดวาระ&#xa;⚠️ Modal: 'ผู้ที่ยังไม่โหวต จะนับเป็น เห็นด้วย อัตโนมัติ'&#xa;คำนวณ: full_term − agree − noc − fail = auto-agree&#xa;อัปเดต countshare, relateshare ใน termpartner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="1175" width="460" height="80" as="geometry" />
        </mxCell>

        <!-- Summary Report -->
        <mxCell id="aRpt" value="📊 สรุปผลการประชุม&#xa;รวม: Onsite (regissub) + Online (votes_online)&#xa;Export PDF / Excel → ส่งให้ OMD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="1275" width="460" height="65" as="geometry" />
        </mxCell>

        <!-- Close Meeting -->
        <mxCell id="aCmtg" value="🔒 ปิดการประชุม (Close Meeting)&#xa;ทำได้หลัง: Vote ครบทุกวาระ + ยืนยัน&#xa;set master.closed_at = NOW() → ทุก API write → reject 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="1360" width="460" height="65" as="geometry" />
        </mxCell>

        <!-- Admin OMD edges -->
        <mxCell id="ea1a2" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2aChg" edge="1" source="a2" target="aChgStatus" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eaChgPrint" edge="1" source="aChgStatus" target="aPrint" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eaPrintOpen" edge="1" source="aPrint" target="aOpen" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eaOpenClose" edge="1" source="aOpen" target="aClose" parent="1">
