        <mxCell id="sp1" value="📱 ผู้ถือหุ้นเคย&#xa;ลงทะเบียน Online&#xa;(status = online_registered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1525" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sp2" value="🏢 วันจริง: มาที่ Venue&#xa;ไม่อยากโหวต Online&#xa;แจ้ง Admin OMD ที่ Venue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="305" y="1525" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sp3" value="⚙️ Admin OMD: เปลี่ยน Status Online → Onsite&#xa;1. ยกเลิก online session (status = converted)&#xa;2. สร้าง regismaim + regissub (Onsite record)&#xa;3. Print Vote Card ส่งให้ผู้ถือหุ้น&#xa;4. บันทึก audit_log (ใคร, เมื่อไหร่, ทำไม)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="550" y="1510" width="350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sp4" value="🗳️ Staff โหวตแทน Onsite&#xa;ตามปกติผ่านระบบ Staff&#xa;UPDATE regissub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="1525" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="esp1sp2" edge="1" source="sp1" target="sp2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esp2sp3" edge="1" source="sp2" target="sp3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esp3sp4" edge="1" source="sp3" target="sp4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- DOUBLE-VOTE PREVENTION + AUDIT                       -->
        <!-- ════════════════════════════════════════════════════ -->
        <mxCell id="dvWarn" value="🔒 ป้องกัน Double-vote | MDES 2563 Compliance&#xa;• ถ้ามี record ใน online_registration (verified/voted) → ต้อง Convert ก่อน Admin จึงสร้าง regissub ได้ — ห้าม insert ซ้ำ&#xa;• UNIQUE constraint (acc_id, term_id) ใน votes_online | ตรวจ cross-table ก่อน pre-fill regissub ทุกครั้ง&#xa;• ทุก action: เปลี่ยน Status, Print, เปิด/ปิดวาระ → บันทึก audit_log (user, timestamp, IP, action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="1640" width="1180" height="85" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- NEXT YEAR PREP                                        -->
        <!-- ════════════════════════════════════════════════════ -->
        <mxCell id="aClr" value="🗑️ เตรียมปีถัดไป — Next Year Prep (OMD Admin ดำเนินการ)&#xa;STEP 1: Auto Backup SQL (safety export)&#xa;STEP 2: Modal Confirm 2 ชั้น (พิมพ์ 'ยืนยันลบข้อมูล') → OMD จัดการเองได้ทันที&#xa;STEP 3: ล้าง + import ใหม่: holder, novote, termpartner | คงไว้ใน DB: regissub, votes_online, online_registration, regismaim, regisgroup, holderlate, audit_log (เก็บตาม meeting_year)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="1750" width="1180" height="85" as="geometry" />
        </mxCell>

