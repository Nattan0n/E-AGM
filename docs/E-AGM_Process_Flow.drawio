        <mxCell id="eOpenStaff" value="เปิดวาระ → Staff โหวตแทนได้" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="aOpen" target="st5" parent="1">
