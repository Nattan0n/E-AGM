        <mxCell id="21" value="📊  Dashboard Real-time&#xa;ผลโหวต Onsite + Online รวม → Export รายงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
