        <!-- ONSITE VOTE -->
        <mxCell id="18" value="เจ้าหน้าที่กดโหวตให้&#xa;เห็นด้วย / ไม่เห็นด้วย / งดออกเสียง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="970" width="300" height="55" as="geometry" />
        </mxCell>

        <!-- ONLINE VOTE -->
