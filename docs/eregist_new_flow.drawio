        <!-- ONSITE: เจ้าหน้าที่ลงทะเบียน -->
        <mxCell id="14" value="เจ้าหน้าที่ลงทะเบียน&#xa;(ระบบเดิม Eregist onsite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="780" width="300" height="55" as="geometry" />
        </mxCell>

        <!-- ONLINE: เปิด Link -->
        <mxCell id="15" value="เปิด Link จาก Email&#xa;หรือขอ OTP ใหม่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="700" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e15" edge="1" source="15" target="16" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pre-reg → Online day (dashed arrow) -->
        <mxCell id="e9" value="ส่ง link ล่วงหน้า" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82b366;fontColor=#82b366;fontSize=9;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="9" target="15" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="547" />
              <mxPoint x="795" y="547" />
              <mxPoint x="795" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ONLINE: Login -->
        <mxCell id="16" value="Login ด้วย Token / OTP&#xa;เข้าหน้าโหวต → รอวาระเปิด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="780" width="300" height="55" as="geometry" />
        </mxCell>

        <!-- ADMIN: เปิดวาระ -->
        <mxCell id="17" value="⚙️  Admin เปิดวาระโหวต&#xa;(Online + Onsite พร้อมกัน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="875" width="340" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e14" edge="1" source="14" target="17" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" source="16" target="17" parent="1">
          <mxGeometry relative="1" as="geometry" />
